<doc-info xmlns="http://sdl.com/FileTypes/SdlXliff/1.0"><cmt-defs><cmt-def id="c1"><Comments><Comment severity="Medium" user="Acme Reviewer" date="2026-11-01T10:00:00" version="1.0">Comment text is not source text.</Comment></Comments></cmt-def><cmt-def id="c2"><Comments><Comment severity="Low" user="Acme Reviewer" date="2026-11-01T10:01:00" version="1.0">Point comment.</Comment></Comments></cmt-def></cmt-defs></doc-info>
