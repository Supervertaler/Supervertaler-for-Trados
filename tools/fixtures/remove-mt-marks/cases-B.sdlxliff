ue key="EndsAt">1446</value><value key="ParagraphFormatting"></value><value key="document">word\document.xml</value></props></cxt-def><cxt-def id="5" type="LocationDetails" purpose="Location"><fmt id="1" /><props><value key="StartsAt">1452</value><value key="EndsAt">1520</value><value key="ParagraphFormatting"></value><value key="document">word\document.xml</value></props></cxt-def><cxt-def id="6" type="LocationDetails" purpose="Location"><fmt id="1" /><props><value key="StartsAt">1526</value><value key="EndsAt">1600</value><value key="ParagraphFormatting"></value><value key="document">word\document.xml</value></props></cxt-def><cxt-def id="7" type="LocationDetails" purpose="Location"><fmt id="1" /><props><value key="StartsAt">1606</value><value key="EndsAt">1669</value><value key="ParagraphFormatting"></value><value key="document">word\document.xml</value></props></cxt-def></cxt-defs></header><body><group><sdl:cxts><sdl:cxt id="1" /><sdl:cxt id="2" /></sdl:cxts><trans-unit id="bdfb8fb8-5ab5-4f10-962a-670a758dee4e"><source xmlns="urn:oasis:names:tc:xliff:document:1.2">Onderhoud van de fiets</source><seg-source><mrk mtype="seg" mid="1">Onderhoud van de fiets</mrk></seg-source><target><mrk mtype="seg" mid="1">Bicycle maintenance</mrk></target><sdl:seg-defs><sdl:seg id="1" conf="Translated" origin="tm" origin-system="Acme TM" percent="100" /></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="3" /><sdl:cxt id="2" /></sdl:cxts><trans-unit id="07856d2c-557c-466f-a853-bb62ac668990"><source xmlns="urn:oasis:names:tc:xliff:document:1.2">Controleer de bandenspanning elke twee weken.</source><seg-source><mrk mtype="seg" mid="2">Controleer de bandenspanning elke twee weken.</mrk></seg-source><target><mrk mtype="seg" mid="2">Check the tire pressure every two weeks.</mrk></target><sdl:seg-defs><sdl:seg id="2" conf="Translated" origin="interactive"><sdl:prev-origin origin="tm" origin-system="Acme TM" percent="85" /></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="4" /><sdl:cxt id="2" /></sdl:cxts><trans-unit id="c7d8935d-50a6-4ec2-952a-ee76714a0171"><source xmlns="urn:oasis:names:tc:xliff:document:1.2">Smeer de ketting na een rit in de regen.</source><seg-source><mrk mtype="seg" mid="3">Smeer de ketting na een rit in de regen.</mrk></seg-source><target><mrk mtype="seg" mid="3">Lubricate the chain after riding in the rain.</mrk></target><sdl:seg-defs><sdl:seg id="3" conf="Translated" origin="tm" origin-system="Acme TM" percent="100"><sdl:prev-origin origin="interactive"><sdl:prev-origin origin="mt" /></sdl:prev-origin></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5" /><sdl:cxt id="2" /></sdl:cxts><trans-unit id="49edd9ce-b0a1-46d8-ae0e-eaee3e62aec6"><source xmlns="urn:oasis:names:tc:xliff:document:1.2">Laat de remmen eenmaal per jaar nakijken.</source><seg-source><mrk mtype="seg" mid="4">Laat de remmen eenmaal per jaar nakijken.</mrk></seg-source><target><mrk mtype="seg" mid="4">Have the brakes checked once a year.</mrk></target><sdl:seg-defs><sdl:seg id="4" conf="Translated" origin="mt" origin-system="DeepL"><sdl:value key="created_by">ACME\tester</sdl:value><sdl:value key="created_on">11/20/2026 09:00:00</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="6" /><sdl:cxt id="2" /></sdl:cxts><trans-unit id="650acf36-ddc8-4860-a3ff-b0e2a12679b2"><source xmlns="urn:oasis:names:tc:xliff:document:1.2">Bewaar de fiets bij voorkeur op een droge plek.</source><seg-source><mrk mtype="seg" mid="5">Bewaar de fiets bij voorkeur op een droge plek.</mrk></seg-source><target><mrk mtype="seg" mid="5">Preferably store the bicycle in a dry place.</mrk></target><sdl:seg-defs><sdl:seg id="5" conf="Draft" origin="mt" /></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="7" /><sdl:cxt id="2" /></sdl:cxts><trans-unit id="e8a84089-02c9-4570-a6b1-c1f95b6de01d"><source xmlns="urn:oasis:names:tc:xliff:document:1.2">Vervang versleten remblokken direct.</source><seg-source><mrk mtype="seg" mid="6">Vervang versleten remblokken direct.</mrk></seg-source><target><mrk mtype="seg" mid="6">Replace worn brake pads immediately.</mrk></target><sdl:seg-defs><sdl:seg id="6" conf="Translated" origin="nmt" /></sdl:seg-defs></trans-unit></group></body></file></xliff>