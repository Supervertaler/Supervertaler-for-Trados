ue key="EndsAt">1471</value><value key="ParagraphFormatting"></value><value key="document">word\document.xml</value></props></cxt-def><cxt-def id="5" type="LocationDetails" purpose="Location"><fmt id="1" /><props><value key="StartsAt">1477</value><value key="EndsAt">1552</value><value key="ParagraphFormatting"></value><value key="document">word\document.xml</value></props></cxt-def><cxt-def id="6" type="LocationDetails" purpose="Location"><fmt id="1" /><props><value key="StartsAt">1558</value><value key="EndsAt">1627</value><value key="ParagraphFormatting"></value><value key="document">word\document.xml</value></props></cxt-def><cxt-def id="7" type="LocationDetails" purpose="Location"><fmt id="1" /><props><value key="StartsAt">1633</value><value key="EndsAt">1709</value><value key="ParagraphFormatting"></value><value key="document">word\document.xml</value></props></cxt-def></cxt-defs></header><body><group><sdl:cxts><sdl:cxt id="1" /><sdl:cxt id="2" /></sdl:cxts><trans-unit id="4ca40b7b-e919-45c6-90d9-4b8b203c27ba"><source xmlns="urn:oasis:names:tc:xliff:document:1.2">Handleiding voor de waterkoker</source><seg-source><mrk mtype="seg" mid="1">Handleiding voor de waterkoker</mrk></seg-source><target><mrk mtype="seg" mid="1">Kettle Instruction manual</mrk></target><sdl:seg-defs><sdl:seg id="1" conf="Translated" origin="interactive"><sdl:prev-origin origin="mt" origin-system="MT / Supervertaler" percent="0" /></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="3" /><sdl:cxt id="2" /></sdl:cxts><trans-unit id="d2e14ba9-932e-407d-af90-3497cdaf41d3"><source xmlns="urn:oasis:names:tc:xliff:document:1.2">Vul de waterkoker nooit boven de maximummarkering.</source><seg-source><mrk mtype="seg" mid="2">Vul de waterkoker nooit boven de maximummarkering.</mrk></seg-source><target><mrk mtype="seg" mid="2">Never fill the kettle above the maximum mark.</mrk></target><sdl:seg-defs><sdl:seg id="2" conf="Translated" origin="mt" /></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="4" /><sdl:cxt id="2" /></sdl:cxts><trans-unit id="4bf6146e-d7ef-408e-878c-52da539b5c69"><source xmlns="urn:oasis:names:tc:xliff:document:1.2">Plaats het apparaat op een vlakke, droge ondergrond.</source><seg-source><mrk mtype="seg" mid="3">Plaats het apparaat op een vlakke, droge ondergrond.</mrk></seg-source><target><mrk mtype="seg" mid="3">Place the appliance on a flat, dry surface.</mrk></target><sdl:seg-defs><sdl:seg id="3" conf="Translated" origin="mt" /></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="5" /><sdl:cxt id="2" /></sdl:cxts><trans-unit id="cbb460f2-0ad3-48c5-9e01-2df57c421f42"><source xmlns="urn:oasis:names:tc:xliff:document:1.2">Druk op de schakelaar om het water te verwarmen.</source><seg-source><mrk mtype="seg" mid="4">Druk op de schakelaar om het water te verwarmen.</mrk></seg-source><target><mrk mtype="seg" mid="4">Press the switch to heat the water.</mrk></target><sdl:seg-defs><sdl:seg id="4" conf="Translated" origin="mt" /></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="6" /><sdl:cxt id="2" /></sdl:cxts><trans-unit id="a49a1ab7-9c6d-4a58-92c3-36090714226a"><source xmlns="urn:oasis:names:tc:xliff:document:1.2">Het lampje gaat uit zodra het water kookt.</source><seg-source><mrk mtype="seg" mid="5">Het lampje gaat uit zodra het water kookt.</mrk></seg-source><target><mrk mtype="seg" mid="5">The indicator light goes out as soon as the water boils.</mrk></target><sdl:seg-defs><sdl:seg id="5" conf="Translated" origin="mt" /></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="7" /><sdl:cxt id="2" /></sdl:cxts><trans-unit id="733fb06b-47ba-4f28-a167-024e406df3df"><source xmlns="urn:oasis:names:tc:xliff:document:1.2">Laat het apparaat afkoelen voordat u het reinigt.</source><seg-source><mrk mtype="seg" mid="6">Laat het apparaat afkoelen voordat u het reinigt.</mrk></seg-source><target><mrk mtype="seg" mid="6">Allow the appliance to cool down before cleaning it.</mrk></target><sdl:seg-defs><sdl:seg id="6" conf="Translated" origin="mt" /></sdl:seg-defs></trans-unit></group></body></file></xliff>