<trans-unit id="00000000-0000-4000-8000-000000000202"><source><mrk mtype="x-sdl-comment" sdl:cid="00000000-0000-4000-8000-0000000000c1">The Acme Mini is the smallest tool. It fits in one hand.</mrk></source><seg-source><mrk mtype="x-sdl-comment" sdl:cid="00000000-0000-4000-8000-0000000000c1"><mrk mtype="seg" mid="2">The Acme Mini is the smallest tool.</mrk> <mrk mtype="seg" mid="3">It fits in one hand.</mrk></mrk></seg-source><target><mrk mtype="seg" mid="2">De Acme Mini is het kleinste gereedschap.</mrk> <mrk mtype="seg" mid="3">Hij past in één hand.</mrk></target><sdl:seg-defs><sdl:seg id="2" conf="Translated" origin="interactive"/><sdl:seg id="3" conf="Translated" origin="interactive"/></sdl:seg-defs></trans-unit>
</group>
<group><sdl:cxts><sdl:cxt id="1"/></sdl:cxts>
<trans-unit id="00000000-0000-4000-8000-000000000203"><source>This last line is fine.</source><seg-source><mrk mtype="seg" mid="4">This last line is fine.</mrk></seg-source><target><mrk mtype="seg" mid="4">Deze laatste regel is in orde.</mrk></target><sdl:seg-defs><sdl:seg id="4" conf="Translated" origin="interactive"/></sdl:seg-defs></trans-unit>
