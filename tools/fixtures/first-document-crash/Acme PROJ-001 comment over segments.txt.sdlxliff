<?xml version="1.0" encoding="utf-8"?>
<!-- Synthetic test file for the first-document crash fixed in 20.205 (see
     README.md in this folder). The second paragraph's two segments sit inside a
     comment marker in <seg-source>, which is how Studio itself stores a Word comment
     that spans whole sentences. Studio's own schema check cannot see segments nested
     that way, so opening this file makes Studio report two messages:
       "SDL XLIFF validation error at line 25 offset ...: The key sequence '2' in
        'urn:oasis:names:tc:xliff:document:1.2:U_tu_segsrc_mid' Keyref fails to refer
        to some key." (and the same for '3').
     The file opens normally apart from that. -->
<xliff xmlns:sdl="http://sdl.com/FileTypes/SdlXliff/1.0" xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2" sdl:version="1.0">
